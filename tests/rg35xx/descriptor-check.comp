#version 460
#extension GL_EXT_nonuniform_qualifier : require
#ifndef GROUP_X
#define GROUP_X 512
#endif
#ifndef GROUP_Y
#define GROUP_Y 1
#endif
layout(local_size_x=GROUP_X, local_size_y=GROUP_Y) in;
layout(set=0,binding=0,std430) buffer Output { uvec4 result[]; } outputData;
layout(set=0,binding=1) uniform sampler2D images[];
const uint count = GROUP_X * GROUP_Y;
shared uint values[count];
void main()
{
    uint local = gl_LocalInvocationIndex;
    uint group = gl_WorkGroupID.x;
    uint index = group * count + local;
    values[local] = local + 100u * group;
    barrier();
    for (uint step = 1u; step < count; step *= 2u) {
        uint other = values[(local + step) & (count - 1u)];
        barrier();
        values[local] += other;
        barrier();
    }
    uint imageIndex = 16383u + (local & 1u);
#ifdef NO_SAMPLE
    vec4 color = vec4(1, 0, 0, 1);
#else
    vec4 color = textureLod(images[nonuniformEXT(imageIndex)], vec2(0.5), 0.0);
#endif
    outputData.result[index] = uvec4(packUnorm4x8(color), values[local],
                                    gl_WorkGroupSize.x, gl_GlobalInvocationID.x);
}
